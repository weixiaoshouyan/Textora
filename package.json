{
  "name": "textora",
  "version": "0.2.0",
  "description": "What You See Is What You Get - Markdown desktop editor",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json && electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@mermaid-js/parser": "^1.2.0",
    "@milkdown/core": "^7.21.3",
    "@milkdown/ctx": "^7.21.3",
    "@milkdown/exception": "^7.21.3",
    "@milkdown/plugin-history": "^7.21.3",
    "@milkdown/plugin-listener": "^7.21.3",
    "@milkdown/preset-commonmark": "^7.21.3",
    "@milkdown/preset-gfm": "^7.21.3",
    "@milkdown/prose": "^7.21.3",
    "@milkdown/theme-nord": "^7.21.3",
    "@milkdown/transformer": "^7.21.3",
    "@milkdown/utils": "^7.21.3",
    "@shikijs/core": "^1.29.2",
    "@shikijs/engine-javascript": "^1.29.2",
    "@shikijs/engine-oniguruma": "^1.29.2",
    "@shikijs/langs": "^1.29.2",
    "@shikijs/themes": "^1.29.2",
    "@shikijs/types": "^1.29.2",
    "@shikijs/vscode-textmate": "^10.0.2",
    "d3": "^7.9.0",
    "dagre-d3-es": "^7.0.14",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "katex": "^0.16.47",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-inline-links": "^7.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "shiki": "^1.29.2",
    "unified": "^11.0.5",
    "unist-util-is": "^6.0.1",
    "unist-util-position": "^5.0.0",
    "unist-util-stringify-position": "^4.0.0",
    "unist-util-visit": "^5.1.0",
    "unist-util-visit-parents": "^6.0.2",
    "uuid": "^14.0.1",
    "vfile": "^6.0.3",
    "vfile-message": "^4.0.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/d3": "^7.4.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.2.4",
    "electron": "^35.7.5",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
