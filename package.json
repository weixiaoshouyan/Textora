{
  "name": "textora",
  "version": "0.2.0",
  "description": "What You See Is What You Get - Markdown desktop editor",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": [
    "electron",
    "electron-winstaller",
    "esbuild"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json && cross-env TEXTORA_DEV=1 electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "package": "npm run build && electron-builder --publish never",
    "package:publish": "npm run build && electron-builder --publish onTag"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mermaid-js/parser": "^1.2.0",
    "@milkdown/core": "^7.21.3",
    "@milkdown/ctx": "^7.21.3",
    "@milkdown/exception": "^7.21.3",
    "@milkdown/plugin-history": "^7.21.3",
    "@milkdown/plugin-listener": "^7.21.3",
    "@milkdown/preset-commonmark": "^7.21.3",
    "@milkdown/preset-gfm": "^7.21.3",
    "@milkdown/prose": "^7.21.3",
    "@milkdown/transformer": "^7.21.3",
    "@milkdown/utils": "^7.21.3",
    "@playwright/test": "^1.62.0",
    "@shikijs/core": "^1.29.2",
    "@shikijs/engine-javascript": "^1.29.2",
    "@shikijs/engine-oniguruma": "^1.29.2",
    "@shikijs/langs": "^1.29.2",
    "@shikijs/themes": "^1.29.2",
    "@shikijs/types": "^1.29.2",
    "@shikijs/vscode-textmate": "^10.0.2",
    "@types/cross-spawn": "^6.0.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "katex": "^0.16.47",
    "mermaid": "^11.16.0",
    "postcss": "^8.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "shiki": "^1.29.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "unified": "^11.0.5",
    "unist-util-is": "^6.0.1",
    "unist-util-position": "^5.0.0",
    "unist-util-stringify-position": "^4.0.0",
    "unist-util-visit": "^5.1.0",
    "unist-util-visit-parents": "^6.0.2",
    "vfile": "^6.0.3",
    "vfile-message": "^4.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  }
}
